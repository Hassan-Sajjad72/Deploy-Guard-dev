# DeployGuard local Docker distribution
# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# Local names assigned to images built from this clone. No Docker Hub account is required.
DEPLOYGUARD_IMAGE_NAMESPACE=deployguard-local
DEPLOYGUARD_IMAGE_TAG=local

# Browser-facing ports
FRONTEND_PORT=5173
BACKEND_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local control-plane PostgreSQL (mandatory local values)
POSTGRES_DB=mini_paas
POSTGRES_USER=mini_paas_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Backend authentication/encryption secrets (mandatory; generate independent random values)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
AUTH_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_32_BYTE_SECRET
ALLOW_INSECURE_USER_HEADER=false

# GitHub OAuth/App (mandatory for repository access and deployment)
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
GITHUB_APP_ID=CHANGE_ME
GITHUB_APP_SLUG=CHANGE_ME
# One-line PEM with literal \n separators; never bake it into an image.
GITHUB_APP_PRIVATE_KEY=CHANGE_ME
GITHUB_ACTIONS_WORKFLOW_FILE=deployguard.yml
DEPLOYGUARD_REUSABLE_WORKFLOW=Hassan-Sajjad72/Deploy-Guard-dev/.github/workflows/deployguard-reusable.yml@70d2ff384de6bd2322011ff8a96118fc2699d882
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_ARN=CHANGE_ME
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_MANAGEMENT=external

# Existing shared AWS foundation / routing (mandatory before real deployments)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=CHANGE_ME
DEPLOYGUARD_VPC_ID=CHANGE_ME
DEPLOYGUARD_PUBLIC_SUBNET_IDS=CHANGE_ME_COMMA_SEPARATED
DEPLOYGUARD_SHARED_ECS_CLUSTER_ARN=CHANGE_ME
DEPLOYGUARD_SHARED_ECS_CLUSTER_NAME=CHANGE_ME
DEPLOYGUARD_SHARED_ALB_ARN=CHANGE_ME
DEPLOYGUARD_SHARED_ALB_DNS_NAME=CHANGE_ME
DEPLOYGUARD_SHARED_ALB_LISTENER_ARN=CHANGE_ME
DEPLOYGUARD_SHARED_ALB_SECURITY_GROUP_ID=CHANGE_ME
DEPLOYGUARD_ROUTING_DOMAIN=CHANGE_ME
DEPLOYGUARD_TERRAFORM_STATE_BUCKET=CHANGE_ME

# Supply only short-lived, least-privilege credentials when local read-only AWS features require them.
# GitHub Actions deployments continue to use OIDC and DEPLOYGUARD_GITHUB_ACTIONS_ROLE_ARN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Monitoring (mandatory local secrets)
PROMETHEUS_SCRAPE_TOKEN=CHANGE_ME_LONG_RANDOM_MONITORING_TOKEN
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD
AWS_RUNTIME_MONITORING_ENABLED=true
CLOUDWATCH_LOGS_ENABLED=true
CLOUDWATCH_METRICS_ENABLED=true
PROMETHEUS_ENABLED=true

# Optional integrations
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NOTIFICATION_DELIVERY_ENABLED=false
SNS_REGION=us-east-1
INFRACOST_ENABLED=false
INFRACOST_API_KEY=
