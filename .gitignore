# ============================================================
# DeployGuard Release 1
# Final repository ignore rules
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
**/.env
**/.env.*

# Safe example files ARE allowed
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

.envrc


# ============================================================
# 2. PRIVATE KEYS / CERTIFICATES / CREDENTIALS
# ============================================================

*.pem
*.key
*.p12
*.pfx

id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

.aws/
credentials/
secrets/

aws-credentials*
google-credentials*
service-account*.json


# ============================================================
# 3. NODE / PACKAGE MANAGER GENERATED DATA
# ============================================================

node_modules/
**/node_modules/

.npm/
**/.npm/

.pnpm-store/
**/.pnpm-store/

.yarn/cache/
.yarn/unplugged/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================================
# 4. BUILD OUTPUT
# ============================================================

dist/
**/dist/

build/
**/build/

out/
**/out/

coverage/
**/coverage/

.vite/
**/.vite/

.next/
**/.next/

.nuxt/
**/.nuxt/

.svelte-kit/
**/.svelte-kit/


# ============================================================
# 5. TERRAFORM GENERATED / LOCAL / SENSITIVE DATA
# ============================================================

.terraform/
**/.terraform/

*.tfstate
*.tfstate.*

*.tfplan
*.plan

terraform.tfvars
*.auto.tfvars
*.tfvars.json

# Safe examples ARE allowed
!*.tfvars.example
!*.tfvars.example.json

crash.log
crash.*.log

# IMPORTANT:
# .terraform.lock.hcl is intentionally NOT ignored.
# Keep provider lock files in Git.


# ============================================================
# 6. DEPLOYGUARD LOCAL RUNTIME DATA
# ============================================================

.deployguard/
**/.deployguard/

backend/.deployguard/


# ============================================================
