#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee -a /var/log/deployguard-bootstrap.log | logger -t deployguard-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive

echo "== DeployGuard bootstrap starting =="

# Terraform associates the EIP immediately after EC2 creation. Wait for
# outbound Internet before attempting package installation.
for attempt in $(seq 1 60); do
  if curl -fsS --max-time 3 https://download.docker.com/ >/dev/null 2>&1; then
    break
  fi
  echo "Waiting for EIP/Internet connectivity... ($attempt/60)"
  sleep 5
done

if ! curl -fsS --max-time 5 https://download.docker.com/ >/dev/null 2>&1; then
  echo "ERROR: outbound Internet never became available."
  exit 1
fi

apt-get update
apt-get upgrade -y
apt-get install -y ca-certificates curl gnupg jq git unzip

# Docker Engine from Docker's official Ubuntu repository.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

. /etc/os-release

cat >/etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $UBUNTU_CODENAME
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

apt-get update
apt-get install -y \
  docker-ce \
  docker-ce-cli \
  containerd.io \
  docker-buildx-plugin \
  docker-compose-plugin

systemctl enable --now docker
usermod -aG docker ubuntu || true

# Initialize exactly one Swarm manager.
SWARM_STATE="$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || true)"
if [ "$SWARM_STATE" != "active" ]; then
  PRIVATE_IP="$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')"
  docker swarm init --advertise-addr "$PRIVATE_IP"
fi

NODE_ID="$(docker node ls -q | head -n1)"
docker node update --label-add deployguard.runtime=true "$NODE_ID" >/dev/null

# Base DeployGuard host layout.
install -d -m 0755 /opt/deployguard
install -d -m 0755 /opt/deployguard/traefik
install -d -m 0700 /opt/deployguard/backups
install -d -m 0755 /opt/deployguard/monitoring
install -d -m 0750 /opt/deployguard/runtime-agent

# Shared ingress network used by Traefik.
if ! docker network inspect deployguard-edge >/dev/null 2>&1; then
  docker network create \
    --driver overlay \
    --attachable \
    --label deployguard.owner=platform \
    deployguard-edge
fi

# Persistent ACME certificate state.
touch /opt/deployguard/traefik/acme.json
chmod 600 /opt/deployguard/traefik/acme.json

cat >/opt/deployguard/traefik/stack.yml <<'STACK'
version: "3.9"

services:
  traefik:
    image: ${traefik_image}

    command:
      - --providers.swarm=true
      - --providers.swarm.endpoint=unix:///var/run/docker.sock
      - --providers.swarm.exposedbydefault=false
      - --providers.swarm.network=deployguard-edge

      - --entrypoints.web.address=:80
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443

      - --certificatesresolvers.letsencrypt.acme.email=${acme_email}
      - --certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.letsencrypt.acme.httpchallenge=true
      - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web

      - --metrics.prometheus=true
      - --accesslog=true
      - --accesslog.format=json
      - --log.level=INFO
      - --api.dashboard=false

    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/deployguard/traefik/acme.json:/letsencrypt/acme.json

    networks:
      - edge

    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure

networks:
  edge:
    external: true
    name: deployguard-edge
STACK

docker stack deploy -c /opt/deployguard/traefik/stack.yml deployguard-edge

cat >/etc/deployguard-runtime.env <<EOF
DEPLOYGUARD_APPS_DOMAIN=${apps_domain}
DEPLOYGUARD_TRAEFIK_SERVICE_NAME=deployguard-edge_traefik
DEPLOYGUARD_RUNTIME_AGENT_SOCKET=/run/deployguard-agent.sock
DEPLOYGUARD_LOCAL_BACKUP_TARGET=/opt/deployguard/backups
EOF
chmod 600 /etc/deployguard-runtime.env

cat >/opt/deployguard/BOOTSTRAP_STATUS.txt <<EOF
DeployGuard RuntimeNode base bootstrap completed.

Installed/configured:
- Docker Engine
- Docker Compose plugin
- single-node Docker Swarm
- deployguard-edge overlay network
- Traefik on public ports 80/443
- Let's Encrypt HTTP-01 support
- local backup directory
- monitoring directory
- Runtime Agent directory

Apps domain: ${apps_domain}

The Runtime Agent executable itself must be installed from the real DeployGuard
repository/release artifact. This bootstrap intentionally does not invent a
repository URL, binary name, or production start command.
EOF

echo "== DeployGuard bootstrap complete =="
docker node ls
docker service ls
