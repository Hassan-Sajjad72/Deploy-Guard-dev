{
  "name": "github-auth-backend",
  "version": "1.0.0",
  "description": "NestJS backend for GitHub OAuth with PostgreSQL",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test:no-legacy-architecture": "ts-node scripts/verify-no-legacy-architecture.ts",
    "test:railpack-runtime-contract": "ts-node scripts/verify-railpack-runtime-contract.ts",
    "test:product-start-schema-integrity": "ts-node scripts/verify-product-start-schema-integrity.ts",
    "test:local-repository-certification": "npm run test:no-legacy-architecture && npm run test:railpack-runtime-contract && npm run test:product-start-schema-integrity",
    "test:full-local-certification": "npm run build && npm --prefix ../frontend run build && npm run test:no-legacy-architecture && npm run test:railpack-runtime-contract && npm run test:product-start-schema-integrity",
    "test:reliability-certification": "npm run test:no-legacy-architecture && npm run test:railpack-runtime-contract",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1079.0",
    "@aws-sdk/client-cloudwatch": "^3.1079.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1079.0",
    "@aws-sdk/client-ecr": "^3.600.0",
    "@aws-sdk/client-ecs": "^3.1079.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1079.0",
    "@aws-sdk/client-iam": "^3.1101.0",
    "@aws-sdk/client-secrets-manager": "^3.1106.0",
    "@aws-sdk/client-sns": "^3.1079.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/typeorm": "^11.0.3",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.1",
    "helmet": "^7.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16.12.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.10.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
