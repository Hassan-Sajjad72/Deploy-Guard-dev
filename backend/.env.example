# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=mini_paas_user
DATABASE_PASSWORD=mini_paas_password
DATABASE_NAME=mini_paas
DATABASE_SSL=false
# Keep false in production; use migrations for schema changes.
TYPEORM_SYNCHRONIZE=false

# Backward-compatible database names used by older local setups
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=mini_paas_user
DB_PASSWORD=mini_paas_password
DB_NAME=mini_paas

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
SESSION_SECRET=change_this_to_another_long_random_secret
AUTH_SESSION_SECRET=change_this_to_another_long_random_secret
ALLOW_INSECURE_USER_HEADER=false

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM may be entered on one line with literal \\n separators.
GITHUB_APP_PRIVATE_KEY=
DEPLOYGUARD_REUSABLE_WORKFLOW=Hassan-Sajjad72/Deploy-Guard-dev/.github/workflows/deployguard-reusable.yml@71f90dc39be671968855889796e43d5eda758b37
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_ARN=
# Use "platform" only when DeployGuard owns the dedicated
# DeployGuardWorkflowCapabilities inline policy on this role.
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_MANAGEMENT=external
DEPLOYGUARD_VPC_ID=
DEPLOYGUARD_PUBLIC_SUBNET_IDS=
DEPLOYGUARD_SHARED_ECS_CLUSTER_ARN=
DEPLOYGUARD_SHARED_ECS_CLUSTER_NAME=
DEPLOYGUARD_SHARED_ALB_ARN=
DEPLOYGUARD_SHARED_ALB_DNS_NAME=
DEPLOYGUARD_SHARED_ALB_LISTENER_ARN=
DEPLOYGUARD_SHARED_ALB_SECURITY_GROUP_ID=
DEPLOYGUARD_ROUTING_DOMAIN=
DEPLOYGUARD_TERRAFORM_STATE_BUCKET=

# GitHub Actions is the deployment execution engine.
GITHUB_ACTIONS_WORKFLOW_FILE=deployguard.yml
GITHUB_ACTIONS_REQUIRED=false
EXTERNAL_CI_REQUIRED=false
# Normal product flow has no manual security/cost approval step. Set true only for legacy gated workflows.
AUTOMATION_MANUAL_APPROVALS_ENABLED=false

# AWS/ECR - optional for now
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ECR_REPOSITORY_PREFIX=mini-paas

# Terraform / Infrastructure Provisioning
TERRAFORM_BIN=terraform
TERRAFORM_WORKING_BASE_DIR=./.deployguard/terraform-workspaces
TERRAFORM_NETWORK_TEMPLATE_DIR=terraform/base-network
TERRAFORM_AUTO_APPROVE=true
TERRAFORM_APPLY_ENABLED=true
TERRAFORM_APPLY_REQUIRES_APPROVAL=true
TERRAFORM_PLAN_TTL_SECONDS=3600
DEPLOYGUARD_DEFAULT_VPC_CIDR=10.0.0.0/16
DEPLOYGUARD_PUBLIC_SUBNET_CIDRS=10.0.1.0/24,10.0.2.0/24
DEPLOYGUARD_PRIVATE_SUBNET_CIDRS=10.0.101.0/24,10.0.102.0/24
DEPLOYGUARD_SINGLE_NAT_GATEWAY=true
DEPLOYGUARD_CLOUDMAP_NAMESPACE=deployguard.local
DEPLOYGUARD_ENABLE_HTTPS=false
DEPLOYGUARD_DEFAULT_APP_PORT=3000

# Trivy / Security Scanning
TRIVY_SCAN_ENABLED=false
TRIVY_TIMEOUT_SECONDS=300
SECURITY_GATE_MODE=bypass
SECURITY_BYPASS_ENABLED=true
SECURITY_BLOCK_CRITICAL=false
SECURITY_BLOCK_HIGH=false
SECURITY_BLOCK_BASE_IMAGE_CRITICAL=false
SECURITY_REQUIRE_FIX_AVAILABLE_TO_BLOCK=true
SECURITY_MEDIUM_APPROVAL_THRESHOLD=5
SECURITY_LOW_BLOCKING=false
SECURITY_ALLOW_HIGH_CRITICAL_OVERRIDE=false
SECURITY_ALLOW_MEDIUM_APPROVAL=false

# FinOps / Cost Analysis
FINOPS_MOCK_MODE=true
INFRACOST_ENABLED=false
COST_GATE_MODE=bypass
FINOPS_ENFORCE_TIER_LIMITS=false
INFRACOST_API_KEY=
INFRACOST_CURRENCY=USD
INFRACOST_CLI_PATH=infracost
FINOPS_DEFAULT_WARNING_THRESHOLD_USD=25
FINOPS_FREE_TIER_LIMIT_USD=10
FINOPS_STARTER_TIER_LIMIT_USD=50
FINOPS_PRO_TIER_LIMIT_USD=200
FINOPS_ENTERPRISE_TIER_LIMIT_USD=999999
FINOPS_TERRAFORM_WORKDIR=
FINOPS_ENABLE_REAL_TERRAFORM=false

# Terraform State Management
TERRAFORM_STATE_BUCKET=deployguard-state-bucket
TERRAFORM_STATE_REGION=us-east-1
TERRAFORM_STATE_PREFIX=projects
TERRAFORM_STATE_USE_LOCKFILE=true
STATE_LOCK_HEARTBEAT_INTERVAL_SECONDS=30
STATE_LOCK_STALE_AFTER_SECONDS=300
STATE_LOCK_MONITOR_INTERVAL_SECONDS=60
STATE_RESOURCE_DROP_WARNING_PERCENT=70
STATE_ENABLE_ORPHAN_AUTO_RECOVERY=true
STATE_ENABLE_FORCE_RELEASE=true
STATE_MOCK_MODE=false

# Persistent Storage / EFS
DEPLOYGUARD_ENABLE_EFS=true
DEPLOYGUARD_EFS_DEFAULT_ENABLED=false
DEPLOYGUARD_EFS_POSIX_UID=1000
DEPLOYGUARD_EFS_POSIX_GID=1000
DEPLOYGUARD_EFS_ROOT_PERMISSIONS=750
DEPLOYGUARD_EFS_ROOT_DIRECTORY_BASE=/deployguard
DEPLOYGUARD_EFS_PERFORMANCE_MODE=generalPurpose
DEPLOYGUARD_EFS_THROUGHPUT_MODE=bursting
DEPLOYGUARD_EFS_TRANSITION_TO_IA=AFTER_30_DAYS
DEPLOYGUARD_EFS_ENABLE_BACKUP=true
DEPLOYGUARD_EFS_BACKUP_RETENTION_DAYS=30
DEPLOYGUARD_EFS_BACKUP_SCHEDULE=cron(0 3 * * ? *)

# ECS Orchestration / Zero-Downtime Deployments
DEPLOYGUARD_ECS_USE_FARGATE_SPOT=true
DEPLOYGUARD_ECS_ENABLE_FARGATE_FALLBACK=true
DEPLOYGUARD_ECS_MIN_TASKS=1
DEPLOYGUARD_ECS_MAX_TASKS=3
DEPLOYGUARD_ECS_CPU_TARGET_PERCENT=60
DEPLOYGUARD_ECS_DEFAULT_CPU=256
DEPLOYGUARD_ECS_DEFAULT_MEMORY=512
DEPLOYGUARD_ECS_LARGE_CPU=512
DEPLOYGUARD_ECS_LARGE_MEMORY=1024
DEPLOYGUARD_ECS_HEALTHCHECK_GRACE_SECONDS=60
DEPLOYGUARD_ECS_CONTAINER_INSIGHTS=false
DEPLOYGUARD_ALB_HEALTHCHECK_PATH=/health
DEPLOYGUARD_ALLOW_HEALTHCHECK_FALLBACK=false
DEPLOYGUARD_ROLLBACK_STABILITY_TIMEOUT_SECONDS=600
DEPLOYGUARD_SERVICE_STABILITY_TIMEOUT_SECONDS=600
DEPLOYGUARD_SERVICE_STABILITY_POLL_INTERVAL_SECONDS=15
DEPLOYGUARD_ALB_HEALTH_TIMEOUT_SECONDS=600
DEPLOYGUARD_ALB_HEALTH_POLL_INTERVAL_SECONDS=15
DEPLOYGUARD_SPOT_EVENT_WEBHOOK_SECRET=
DEPLOYGUARD_ENABLE_EVENTBRIDGE_SPOT_RULE=true
DEPLOYGUARD_ENABLE_AUTO_ROLLBACK=true
DEPLOYGUARD_SPOT_RECOVERY_COOLDOWN_SECONDS=120

# Observability / Monitoring
AWS_RUNTIME_MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_SCRAPE_TOKEN=replace-with-a-long-random-monitoring-token
GRAFANA_BASE_URL=http://localhost:3001/d/deployguard-runtime/deployguard-runtime
PROMETHEUS_QUERY_TIMEOUT_SECONDS=10
PROMETHEUS_CPU_QUERY=
PROMETHEUS_MEMORY_QUERY=
PROMETHEUS_HTTP_LATENCY_QUERY=
PROMETHEUS_REQUEST_RATE_QUERY=
CLOUDWATCH_LOGS_ENABLED=true
CLOUDWATCH_LOG_GROUP_NAME=
CLOUDWATCH_METRICS_ENABLED=true
OBSERVABILITY_AWS_METRICS_CACHE_SECONDS=60
OBSERVABILITY_LOG_STREAM_POLL_INTERVAL_SECONDS=5
OBSERVABILITY_LOG_STREAM_MAX_EVENTS=100
OBSERVABILITY_LOG_STREAM_HEARTBEAT_SECONDS=15
OBSERVABILITY_LOG_RECONNECT_MILLISECONDS=5000
OBSERVABILITY_LOG_HISTORY_MINUTES=15
OBSERVABILITY_LOG_HISTORY_MAX_EVENTS=200
OBSERVABILITY_MASK_SECRETS=true
OBSERVABILITY_DEFAULT_RANGE=1h

# Modules 6.13–6.17: AI troubleshooting (server-side only)
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=google
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_TEMPERATURE=0.1
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_STATUS_TIMEOUT_MS=2000
AI_PROVIDER_STATUS_CACHE_MS=30000
AI_PROVIDER_MAX_OUTPUT_TOKENS=1200

# Amazon SNS email notifications. Empty topic means skipped_unconfigured.
NOTIFICATION_DELIVERY_ENABLED=false
SNS_TOPIC_ARN=
SNS_REGION=us-east-1

# Terraform export archives are stored briefly in PostgreSQL, then expire.
TERRAFORM_EXPORT_MAX_BYTES=10485760

# Stripe hosted billing. The provider remains disabled unless the exact gate is true.
BILLING_DEMO_MODE=false
BILLING_PROVIDER_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Plan and usage enforcement (disable only for local/FYP testing)
PLAN_USAGE_ENFORCEMENT_ENABLED=false
USAGE_LIMITS_ENABLED=false
SUBSCRIPTION_LIMITS_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# Authoritative cloud-state cache (read-only AWS reconciliation)
CLOUD_VERIFICATION_TTL_SECONDS=180
CLOUD_HTTP_HEALTH_VERIFICATION_ENABLED=true
