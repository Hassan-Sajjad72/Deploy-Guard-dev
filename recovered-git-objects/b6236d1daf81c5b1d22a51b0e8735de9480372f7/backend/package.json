    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "worker:pipeline": "ts-node -r tsconfig-paths/register src/pipeline.worker.ts",
    "dev:worker": "npm run worker:pipeline",
    "test:detection": "ts-node scripts/verify-stack-detection.ts",
    "test:deployability-preflight": "ts-node scripts/verify-deployability-preflight.ts",
    "test:database-tier": "ts-node scripts/verify-database-tier.ts",
    "test:service-binding": "ts-node scripts/verify-service-binding.ts",
    "test:pre-mutation-contract": "ts-node scripts/verify-pre-mutation-contract.ts",
    "test:apply-entry-point": "ts-node scripts/verify-apply-entry-point.ts",
    "test:configuration-lock-serialization": "ts-node scripts/verify-configuration-lock-serialization.ts",
    "test:final-plan-integrity": "ts-node scripts/verify-final-plan-integrity.ts",
    "test:final-stabilization": "ts-node scripts/verify-final-stabilization.ts",
    "test:real-local-concurrency": "ts-node scripts/verify-real-local-concurrency.ts",
    "test:task-definition-rendering": "ts-node scripts/verify-task-definition-rendering.ts",
    "test:unknown-plan-policy": "ts-node scripts/verify-unknown-plan-policy.ts",
    "test:database-terraform-descriptions": "ts-node scripts/verify-database-terraform-descriptions.ts",
    "test:auth": "ts-node scripts/verify-authentication.ts",
    "test:automation": "ts-node scripts/verify-automation-controls.ts",
    "test:security-policy": "ts-node scripts/verify-security-policy.ts",
    "test:docker-templates": "ts-node scripts/verify-docker-templates.ts",
    "test:ai-troubleshooting": "ts-node scripts/verify-ai-troubleshooting.ts",
    "test:s3-state-lockfile": "ts-node scripts/verify-s3-state-lockfile.ts",
    "test:demo-configuration": "ts-node scripts/verify-demo-configuration.ts",
    "test:notifications": "ts-node scripts/verify-notifications.ts",
    "test:infrastructure-lifecycle": "ts-node scripts/verify-infrastructure-lifecycle.ts",
    "test:cloud-cleanup": "ts-node scripts/verify-cloud-cleanup.ts",
    "test:central-cloud-cleanup": "ts-node scripts/verify-central-cloud-cleanup.ts",
    "test:cleanup-command-center": "ts-node scripts/verify-cleanup-command-center.ts",
