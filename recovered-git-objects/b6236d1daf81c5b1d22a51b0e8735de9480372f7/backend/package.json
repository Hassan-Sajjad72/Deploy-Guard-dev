    "test:current-run-recovery": "ts-node scripts/verify-current-run-recovery.ts",
    "test:terraform-approval-lifecycle": "ts-node scripts/verify-terraform-approval-lifecycle.ts",
    "test:deployment-recovery": "ts-node scripts/verify-deployment-recovery.ts",
    "test:stage-selective-resume": "ts-node scripts/verify-stage-selective-resume.ts",
    "test:deployment-requirements": "ts-node scripts/verify-deployment-requirements.ts",
    "test:terraform-export": "ts-node scripts/verify-terraform-export.ts",
    "test:billing": "ts-node scripts/verify-billing.ts",
    "test:project-usage": "ts-node scripts/verify-project-usage.ts",
    "test:version14-remediation": "ts-node scripts/verify-version14-remediation.ts",
