{
  "name": "github-auth-backend",
  "version": "1.0.0",
  "description": "NestJS backend for GitHub OAuth with PostgreSQL",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test:detection": "ts-node scripts/verify-stack-detection.ts",
    "test:migration-iteration1": "ts-node scripts/verify-github-actions-migration-iteration1.ts",
    "test:deployability-preflight": "ts-node scripts/verify-deployability-preflight.ts",
    "test:auth": "ts-node scripts/verify-authentication.ts",
    "test:automation": "ts-node scripts/verify-automation-controls.ts",
    "test:operator-segregation": "ts-node scripts/verify-operator-admin-segregation.ts",
    "test:docker-templates": "ts-node scripts/verify-docker-templates.ts",
    "test:detection-contract-gate": "ts-node scripts/verify-detection-contract-gate.ts",
    "test:ai-troubleshooting": "ts-node scripts/verify-ai-troubleshooting.ts",
    "test:current-state-consistency": "ts-node scripts/verify-current-state-consistency.ts",
    "test:github-actions-current-state": "ts-node scripts/verify-github-actions-current-state.ts",
    "test:immutable-release-workflow": "ts-node scripts/verify-immutable-release-workflow.ts",
    "test:deployment-requirements": "ts-node scripts/verify-deployment-requirements.ts",
    "test:terraform-export": "ts-node scripts/verify-terraform-export.ts",
    "test:manifest-secret-safety": "ts-node scripts/verify-manifest-secret-safety.ts",
    "test:legacy-retirement": "ts-node scripts/verify-legacy-retirement.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecr": "^3.600.0",
    "@aws-sdk/client-ecs": "^3.1079.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1079.0",
    "@aws-sdk/client-iam": "^3.1101.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^7.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.10.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
