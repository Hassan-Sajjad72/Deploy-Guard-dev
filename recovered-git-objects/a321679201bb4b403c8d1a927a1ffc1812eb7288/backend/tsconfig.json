{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/orchestration-contracts/**",
    "src/infrastructure-lifecycle/**",
    "src/orchestration/**",
    "src/state-management/**",
    "src/storage/**",
    "src/finops/**",
    "src/observability/**",
    "src/projects/pipeline/pipeline.queue.ts",
    "src/projects/pipeline/pipeline.service.ts",
    "src/projects/pipeline/pipeline-worker.service.ts",
    "src/projects/pipeline/pipeline-job-finality.service.ts",
    "src/projects/recovery/**",
    "src/projects/normal-deployment-command.service.ts",
    "src/pipeline.worker.ts"
  ]
}
